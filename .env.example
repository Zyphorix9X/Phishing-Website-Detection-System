# Generate locally with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-secret
APP_ENV=development

# Leave DATABASE_URL blank for the existing local SQLite database.
# Production example: postgresql+psycopg://phishing_app:password@localhost:5432/phishing_db
DATABASE_URL=
AUTO_CREATE_DB=false
SESSION_COOKIE_SECURE=false
APP_PORT=5000

# Redis/Celery are optional locally. Docker Compose enables both services.
REDIS_URL=
RATE_LIMIT_STORAGE_URI=memory://
BACKGROUND_ANALYSIS_ENABLED=false

# Bounded RDAP registration lookup. This never opens the submitted site.
ENABLE_RDAP_LOOKUP=true

# Optional providers; PhishTank requests submit the scanned URL to PhishTank.
PHISHTANK_API_KEY=
OPENPHISH_FEED_URL=

# Optional feeds should use the fixed OpenPhish community endpoint:
# OPENPHISH_FEED_URL=https://openphish.com/feed.txt
POSTGRES_PASSWORD=replace-this-database-password
